# ============================================
# HTCondor Submission File
# ============================================
#
# This file defines the job requirements and submission parameters
# for running a parameter sweep on the PIC HTCondor cluster.
#
# Usage: condor_submit submit.sub
#

# ============================================
# Executable and Arguments
# ============================================

# Path to the bash script that will be executed on worker nodes
executable = /nfs/pic.es/user/l/ldomingo/complexity/HPC/subash.sh

initialdir = /nfs/pic.es/user/l/ldomingo/complexity

# Fix maximum number of threads
environment = "OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 QISKIT_NUM_PROCS=1"

# Command-line arguments passed to the executable
arguments = $(ns) $(gates_name) $(degree) $(num_gates) $(n_layers)

# ============================================
# Output Files
# ============================================

# Standard output: job results and print statements
output = /nfs/pic.es/user/l/ldomingo/complexity/jobs/ORS/noise_basis/outs/$(gates_name)_ns$(ns)_deg$(degree)_ng$(num_gates)_L$(n_layers).out

# Standard error: error messages and warnings
error  = /nfs/pic.es/user/l/ldomingo/complexity/jobs/ORS/noise_basis/errs/$(gates_name)_ns$(ns)_deg$(degree)_ng$(num_gates)_L$(n_layers).err

# HTCondor log: job lifecycle events (submission, start, completion)
log    = /nfs/pic.es/user/l/ldomingo/complexity/jobs/ORS/noise_basis/logs/$(gates_name)_ns$(ns)_deg$(degree)_ng$(num_gates)_L$(n_layers).log

# ============================================
# Resource Requirements
# ============================================

# Number of CPU cores requested per job
request_cpus = 1

# Memory requirement per job
request_memory = 8 GB

# Job flavor: determines maximum walltime
# Options: "short" (< 3h), "medium" (3-24h), "long" (> 24h)
+flavour = "long"

# Hardware requirements: worker node must support AVX instructions
requirements = Has_avx == true

# ============================================
# Job Queue
# ============================================
#
# One job per line from params.txt
#
# Expected columns in params.txt:
# nqbits ns alpha gates_name degree depth scrambler_K scrambler_layer
#
# Use a placeholder such as -1 for parameters that do not apply.
#
# Example:
# 100 Haar -1 -1 -1
# 100 G1 -1 20 -1
# 100 D2_random 4 -1 1

queue ns, gates_name, degree, num_gates, n_layers from /nfs/pic.es/user/l/ldomingo/complexity/HPC/parameters.txt